{
  "name": "Harmonia FC",
  "short_name": "Harmonia",
  "description": "Gestão do time Harmonia FC: presença, sorteio, campeonato e carnê.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a1428",
  "theme_color": "#0a1428",
  "icons": [
    {
      "src": "./assets/harmonia-crest.jpeg",
      "type": "image/jpeg",
      "sizes": "640x640",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./receber-comprovante",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "comprovante",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
